{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ESNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "noEmit": false
  },
  "ts-node": {
    "esm": true,
    "files": true
  },
  "include": ["./src/**/*.ts", "./src/**/*.d.ts"]
}
